{
  "version": 1,
  "title": "Setup and init: today vs proposed",
  "subtitle": "Walk each tree, compare the dashed links, leave notes, then copy for agent",
  "trees": [
    {
      "id": "today",
      "label": "Today (0.3.2)",
      "nodes": [
        { "id": "t-start", "kind": "start", "label": "Today, 0.3.2", "sub": "npx @wolven-tech/harness setup", "next": "t-where" },
        {
          "id": "t-where",
          "kind": "choice",
          "tag": "setup",
          "label": "Where does setup run?",
          "options": [
            { "key": "root", "label": "At a git top-level", "next": "t-scaffold" },
            { "key": "outside", "label": "Anywhere else", "hint": "e.g. beside a client repo", "next": "t-refuse" }
          ]
        },
        {
          "id": "t-refuse",
          "kind": "card",
          "label": "setup exits 1",
          "sections": [
            { "head": "What happens", "items": ["\"not a git top-level\"", "No supported place when the client repo can't hold harness files", "Users hand-roll a layout, like the audited install"] }
          ]
        },
        { "id": "t-scaffold", "kind": "waypoint", "tag": "setup", "label": "Scaffolds .agents/, docs/, WOLVEN.md; links .claude/skills; CLAUDE.md = @AGENTS.md", "next": "t-qmd" },
        { "id": "t-qmd", "kind": "waypoint", "tag": "setup", "label": "Writes .qmd/index.yml; never checks qmd is installed", "next": "t-mode" },
        {
          "id": "t-mode",
          "kind": "choice",
          "tag": "harness-init step 0",
          "label": "Entry mode for AGENTS.md?",
          "options": [
            { "key": "full", "label": "Full", "hint": "WOLVEN.md folded in", "next": "t-full" },
            { "key": "light", "label": "Light", "hint": "short block", "next": "t-light" },
            { "key": "mention", "label": "Mention-only", "hint": "one plain-text line", "next": "t-mention" }
          ]
        },
        { "id": "t-full", "kind": "waypoint", "tag": "router", "label": "Router in context; rules only as one-line bullets", "next": "t-conv" },
        { "id": "t-light", "kind": "waypoint", "tag": "router", "label": "Short block in context; rules only as bullets", "next": "t-conv" },
        { "id": "t-mention", "kind": "waypoint", "tag": "router", "label": "No import: router and rules never reach the agent", "next": "t-conv" },
        { "id": "t-conv", "kind": "waypoint", "tag": "commits", "label": "code-commit and code-pr: Conventional Commits only", "next": "t-validate" },
        { "id": "t-validate", "kind": "waypoint", "tag": "validate", "label": "Green as soon as AGENTS.md mentions WOLVEN.md", "next": "t-end" },
        {
          "id": "t-end",
          "kind": "card",
          "label": "Looks finished, half works",
          "sections": [
            { "head": "What the agent gets", "items": ["Skills, through .claude/skills", "Router only in Full or Light", "Rules: .agents/rules is not loaded by Claude Code (alwaysApply is Cursor's)", "qmd missing: silent fallback to grep"] },
            { "head": "What flags it", "items": ["Nothing: validate is green and there is no doctor"] }
          ]
        }
      ]
    },
    {
      "id": "proposed",
      "label": "Proposed",
      "nodes": [
        { "id": "p-start", "kind": "start", "label": "Proposed", "sub": "npm install -g @wolven-tech/harness", "next": "p-where" },
        {
          "id": "p-where",
          "kind": "choice",
          "tag": "setup",
          "label": "Where does setup run?",
          "options": [
            { "key": "root", "label": "At a git top-level", "hint": "same as today", "next": "p-scaffold" },
            { "key": "outside", "label": "Anywhere else", "hint": "now supported", "next": "p-wire" }
          ]
        },
        { "id": "p-scaffold", "kind": "waypoint", "tag": "setup", "label": "Same scaffold as today", "next": "p-mode" },
        { "id": "p-mode", "kind": "waypoint", "tag": "harness-init", "label": "Entry mode as today, but every mode loads router and rules in each runtime", "next": "p-conv" },
        { "id": "p-wire", "kind": "waypoint", "tag": "setup", "label": "Writes only skills and runtime wiring in this folder", "next": "p-handoff" },
        { "id": "p-handoff", "kind": "waypoint", "tag": "setup", "label": "Prints: open your agent here and run harness-init", "next": "p-layout" },
        {
          "id": "p-layout",
          "kind": "choice",
          "tag": "harness-init",
          "label": "What does this folder hold?",
          "default": "fresh",
          "options": [
            { "key": "fresh", "label": "Nothing yet", "hint": "default layout", "next": "p-home" },
            { "key": "existing", "label": "An existing layout", "hint": "e.g. harness beside the code", "next": "p-keep" }
          ]
        },
        { "id": "p-home", "kind": "waypoint", "tag": "harness-init", "label": "Proposes a harness home: git init here after OK, code repo inside and in .gitignore", "next": "p-conv" },
        { "id": "p-keep", "kind": "waypoint", "tag": "harness-init", "label": "Recognises the layout, keeps it, wires the runtime in place", "next": "p-conv" },
        {
          "id": "p-conv",
          "kind": "choice",
          "tag": "harness-init",
          "label": "Code repo's commit convention?",
          "default": "inferred",
          "options": [
            { "key": "inferred", "label": "Found in git log", "hint": "e.g. DEV-123: …, Human confirms", "next": "p-load" },
            { "key": "ask", "label": "No clear pattern", "hint": "ask; Conventional by default", "next": "p-load" }
          ]
        },
        { "id": "p-load", "kind": "waypoint", "tag": "runtime", "label": "Router and four rules in context from turn one; a missing tool is reported, not routed around", "next": "p-doctor" },
        {
          "id": "p-doctor",
          "kind": "choice",
          "tag": "doctor",
          "label": "wolven-harness doctor: minimal install passes?",
          "options": [
            { "key": "pass", "label": "Every check passes", "hint": "exit 0", "next": "p-ok" },
            { "key": "fail", "label": "Something fails", "hint": "exit 1, each failure names its fix", "next": "p-repair" }
          ]
        },
        { "id": "p-repair", "kind": "waypoint", "tag": "harness-doctor skill", "label": "One fix at a time, after OK; keeps the layout; refreshes unedited stale templates; reruns doctor", "next": "p-fixed" },
        {
          "id": "p-ok",
          "kind": "card",
          "label": "Working install",
          "sections": [
            { "head": "Minimal install", "items": ["Router and rules load in each wired runtime", "Skills resolve where the agent opens", "docs/ lives in a repo you can commit to", "qmd installed and indexed"] },
            { "head": "Warnings only", "items": ["CLI not installed globally", "Project skills older than the global CLI", "Drift: edited, stale or missing template files"] }
          ]
        },
        {
          "id": "p-fixed",
          "kind": "card",
          "label": "Repaired install",
          "sections": [
            { "head": "Closing summary", "items": ["What changed", "Declined fixes listed as still failing", "doctor rerun result"] }
          ]
        }
      ]
    },
    {
      "id": "existing",
      "label": "Existing install, after upgrade",
      "nodes": [
        { "id": "e-start", "kind": "start", "label": "A half-working install", "sub": "like the audited one", "next": "e-doctor" },
        { "id": "e-doctor", "kind": "waypoint", "tag": "doctor", "label": "wolven-harness doctor exits 1 and lists router, rules, qmd, unversioned docs", "next": "e-skill" },
        { "id": "e-skill", "kind": "waypoint", "tag": "harness-doctor skill", "label": "Proposes each fix; wires in place; never moves folders unless a check can't pass otherwise", "next": "e-end" },
        {
          "id": "e-end",
          "kind": "card",
          "label": "Same layout, working install",
          "sections": [
            { "head": "Not forced", "items": ["Layout kept", "Client repo untouched", "Convention recorded instead of overridden"] }
          ]
        }
      ]
    }
  ],
  "links": [
    { "from": "t-where", "to": "p-where", "label": "outside now supported" },
    { "from": "t-mention", "to": "p-mode", "label": "every mode loads" },
    { "from": "t-conv", "to": "p-conv", "label": "learns the repo's convention" },
    { "from": "t-validate", "to": "p-doctor", "label": "doctor checks what validate can't" },
    { "from": "t-end", "to": "e-start", "label": "repair path" }
  ],
  "annotations": [
    { "id": "a-adr", "target": "p-wire", "text": "Changes ADR-006's exit rule: the spec writes its successor ADR" },
    { "id": "a-multi", "target": "p-home", "text": "One code repo per install; multi-repo is deferred" },
    { "id": "a-qmd", "target": "p-doctor", "text": "qmd has no opt-out: without it, doctor fails" },
    { "id": "a-drift", "target": "p-ok", "text": "The drift report replaces the deferred setup --check" },
    { "id": "a-runtimes", "target": "p-start", "text": "setup detects installed agents (Claude Code and AGENTS.md runtimes); the Human confirms" },
    { "id": "a-pm-today", "target": "t-scaffold", "text": "Every printed command assumes pnpm" },
    { "id": "a-pm", "target": "p-scaffold", "text": "Commands use the project's npm, yarn or pnpm; no package.json means the global binary" }
  ]
}
